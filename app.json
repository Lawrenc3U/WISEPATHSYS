{
  "expo": {
    "name": "WisePath",
    "slug": "wisepath",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/wisepath.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/wisepath.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "wisepath",
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WisePath to access your photos for your profile picture."
        }
      ],
      "expo-splash-screen"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/wisepath.jpg",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/wisepath.jpg"
    }
  }
}
